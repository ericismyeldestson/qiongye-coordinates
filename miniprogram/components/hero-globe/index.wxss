:host { display: block; width: 100%; height: 100%; pointer-events: none; }
.globe { position: relative; width: 100%; height: 100%; pointer-events: none; }
.globe-canvas { display: block; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
.globe-canvas.is-ready { opacity: 1; }
.globe-fallback { position: absolute; width: 59.5%; height: 59.5%; top: 20.25%; left: 20.25%; border-radius: 50%; background: radial-gradient(circle at 30% 25%,#284054,#111d2d 65%,#090f18); border: 1rpx solid #655a42; box-shadow: 0 0 20rpx #d4b46a33; }
