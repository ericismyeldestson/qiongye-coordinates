/* 穹野坐标: shared visual roles. Business state lives in the existing pages. */
page {
 --page: #111b2c;
 --surface: #182438;
 --surface-low: #131f31;
 --field: #101d30;
 --line: #33435a;
 --text: #f1eadc;
 --muted: #aab8cc;
 --gold: #e4c48a;
 background: var(--page);
 color: var(--text);
 font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
 font-size: 30rpx;
 line-height: 1.6;
}
view,text,input,button,scroll-view { box-sizing: border-box; }
button { margin: 0; border-radius: 20rpx; font-size: 30rpx; line-height: 1.5; }
button::after { border: 0; }
button[disabled] { opacity: .55; }
input { width: 100%; min-width: 0; height: 48px; min-height: 48px; color: var(--text); font-size: 32rpx; }
picker { min-height: 48px; display: flex; align-items: center; font-size: 30rpx; }
picker>view { width: 100%; overflow-wrap: anywhere; }
.page { padding: 36rpx 32rpx calc(56rpx + env(safe-area-inset-bottom)); }
.row { display: flex; align-items: center; gap: 20rpx; }
.between { justify-content: space-between; }
.grid2 { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 20rpx; }
.eyebrow { color: var(--gold); letter-spacing: 4rpx; font-size: 22rpx; font-weight: 650; }
.muted { color: var(--muted); }
.small { font-size: 26rpx; }
.gold { color: var(--gold); }
.badge { color: #a8d4c6; font-size: 24rpx; }
.hero-title { font-family: Georgia,"Songti SC",serif; font-size: 66rpx; font-weight: 400; line-height: 1.22; letter-spacing: -1rpx; margin: 30rpx 0 22rpx; }
.hero-desc { color: #b6c2d3; font-size: 30rpx; max-width: 620rpx; line-height: 1.8; }
.card { background: var(--surface); border: 1rpx solid #2c3b51; border-radius: 28rpx; padding: 28rpx; margin-top: 32rpx; }
.card-title { font-size: 34rpx; font-weight: 600; margin-bottom: 24rpx; }
.field { background: var(--field); border: 1rpx solid var(--line); border-radius: 18rpx; padding: 16rpx 20rpx 4rpx; margin-bottom: 20rpx; min-width: 0; }
.label { display: block; color: var(--muted); font-size: 26rpx; margin-bottom: 2rpx; }
.primary { background: #e4c793; color: #172235; padding: 24rpx; font-weight: 650; min-height: 48px; width: 100%; }
.secondary { background: #24354d; border: 1rpx solid #3b4d66; color: #efe5d3; padding: 18rpx 24rpx; min-height: 44px; }
.text-btn { display: flex; align-items: center; justify-content: center; color: #e5ca98; background: transparent; font-size: 28rpx; padding: 12rpx 4rpx; min-height: 44px; }
.pill { display: inline-flex; align-items: center; justify-content: center; background: #1c2c43; border: 1rpx solid #3b4c65; border-radius: 50rpx; padding: 14rpx 24rpx; min-height: 44px; font-size: 28rpx; color: #c9d4e4; white-space: nowrap; }
.pill.active { border-color: #c2a36c; background: #3b352d; color: #f3d7a1; }
.error { background: #39292f; color: #ffd0c7; border: 1rpx solid #754b50; padding: 24rpx; border-radius: 18rpx; margin: 24rpx 0; font-size: 28rpx; }
.notice { color: var(--muted); font-size: 26rpx; line-height: 1.8; overflow-wrap: anywhere; }
.choice-list { border: 1rpx solid #455773; border-radius: 18rpx; overflow: hidden; margin-bottom: 24rpx; max-height: 480rpx; }
.choice { padding: 24rpx; background: #20314a; border-bottom: 1rpx solid #3b4c65; min-height: 52px; }
.choice:last-child { border: 0; }
.footer { font-size: 24rpx; color: #a1afc4; text-align: center; margin: 36rpx 0 0; line-height: 1.9; }
.privacy-link { color: #e5ca98; min-height: 44px; display: flex; align-items: center; padding: 8rpx 0; font-size: 26rpx; }
.footer .privacy-link { justify-content: center; }
.divider { height: 1rpx; background: #33435a; margin: 28rpx 0; }
/* Override WeChat v2 default widths explicitly for compact controls. */
button.primary { width: 100%; max-width: none; }
button.pill,button.text-btn,button.secondary { width: auto; min-width: 0; flex-shrink: 0; }
@media (max-width: 350px) {
 .page { padding-left: 24rpx; padding-right: 24rpx; }
 .card { padding: 24rpx; }
 .grid2 { gap: 14rpx; }
 .badge { font-size: 23rpx; }
}
/* Prevent rpx typography from becoming too small on 320 px screens. */
@media (max-width: 350px) {
 page { font-size: 15px; }
 input { font-size: 16px; }
 picker { font-size: 14px; }
 .notice,.small,.label { font-size: 13px; }
 .hero-desc { font-size: 15px; }
 .text-btn,.pill { font-size: 14px; }
 .footer { font-size: 12px; }
}
