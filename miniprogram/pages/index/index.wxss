.birth-hero { position: relative; padding: 4rpx 2rpx 12rpx; }
.hero-heading { position: relative; display: flex; align-items: center; min-height: 260rpx; margin: 8rpx 0 4rpx; }
.birth-hero .hero-title { position: relative; width: 440rpx; margin: 0; font-size: 60rpx; }
.hero-planet { position: absolute; right: -12rpx; top: 0; width: 260rpx; height: 260rpx; pointer-events: none; }
.birth-hero .hero-desc { position: relative; }
.birth-card { margin-top: 30rpx; }
.section-heading { margin-bottom: 26rpx; }
.section-heading .card-title { margin: 0; }
.step-label { font-size: 24rpx; letter-spacing: 1rpx; color: #a8b8cc; }
.example-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; margin: 14rpx 0 22rpx; }
.example-grid>button.pill { width: 100%; padding: 12rpx 8rpx; font-size: 28rpx; }
.example-note { padding-bottom: 24rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid #33435a; }
.source-note { margin-bottom: 24rpx; padding: 20rpx; border-left: 3rpx solid #a78d62; background: #1b2b40; border-radius: 0 12rpx 12rpx 0; }
.source-note .text-btn { justify-content: flex-start; }
.location-meta { line-height: 1.7; font-size: 24rpx; overflow-wrap: anywhere; }
.location-feedback { padding: 20rpx; background: #202f43; border-radius: 16rpx; }
.advanced-toggle { width: 100%!important; justify-content: space-between; margin-top: 12rpx; text-align: left; }
.advanced-fields { margin-top: 22rpx; padding-top: 24rpx; border-top: 1rpx solid #3c4a5d; }
.advanced-fields .notice { margin-bottom: 22rpx; }
.manual-location { padding: 20rpx; background: #202f43; border-radius: 16rpx; }
.manual-location .secondary { width: 100%; margin-top: 18rpx; }
.generate-button { margin-top: 28rpx; display: flex; align-items: center; justify-content: center; gap: 18rpx; }
.birth-features { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx 22rpx; margin-top: 28rpx; color: #b1bfd2; font-size: 25rpx; }
.birth-footer { margin-top: 24rpx; }
.personal-entry { width: 100%!important; margin-bottom: 24rpx; }
.personal-note { margin-bottom: 24rpx; }
.example-confirmation { background: #202f43; border: 1rpx solid #78684e; border-radius: 18rpx; padding: 22rpx; margin-top: 24rpx; }
.example-confirmation .secondary { width: 100%; margin-top: 18rpx; }
@media (max-width: 350px) {
 .example-grid>button.pill { font-size: 29rpx; }
 .field { padding-left: 16rpx; padding-right: 16rpx; }
}
